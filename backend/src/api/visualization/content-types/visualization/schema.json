{
  "kind": "collectionType",
  "collectionName": "visualizations",
  "info": {
    "singularName": "visualization",
    "pluralName": "visualizations",
    "displayName": "Visualization"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "description": {
      "type": "text",
      "required": true
    },
    "featuredImage": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "url": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "category": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::visualization-category.visualization-category"
    },
    "content": {
      "type": "dynamiczone",
      "components": [
        "shared.text-block",
        "shared.cta",
        "shared.faqs",
        "shared.audience-section",
        "shared.dashboard-action",
        "shared.challenges",
        "shared.kpi-business-impact",
        "shared.dashboard-improvement",
        "shared.contact-us",
        "shared.rich-text"
      ]
    }
  }
}
