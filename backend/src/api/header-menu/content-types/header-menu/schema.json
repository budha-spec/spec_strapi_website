{
  "kind": "collectionType",
  "collectionName": "header_menus",
  "info": {
    "singularName": "header-menu",
    "pluralName": "header-menus",
    "displayName": "Header Menu"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "url": {
      "type": "string",
      "required": true
    },
    "menuOrder": {
      "type": "integer",
      "required": false,
      "unique": true
    },
    "image": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "child_menu": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::header-menu.header-menu",
      "inversedBy": "parent_menu"
    },
    "parent_menu": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::header-menu.header-menu",
      "mappedBy": "child_menu"
    },
    "content": {
      "type": "dynamiczone",
      "components": [
        "shared.text-block",
        "shared.industry-menu-section",
        "shared.insights-menu-section",
        "shared.about-menu-social",
        "shared.rich-text"
      ]
    }
  }
}
